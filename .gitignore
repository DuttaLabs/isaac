# Dependencies
node_modules/

# macOS
.DS_Store

# Editor / tooling local state
.claude/settings.local.json
*.log

# OpticStudio's bundled sample files are Zemax/Ansys copyright — usable locally,
# never committed to this public repo.
zmx files from Zemax/

# Local reference texts and working notes — kept on disk, not pushed.
SupportingMaterial/

# Lenses saved from Isaac itself while working. The corpus beside them is
# tracked on purpose; this folder is scratch, and is not.
ZMX files/myZMXfiles/

# Lens files collected from published papers — third-party supplementary
# material, kept on disk for testing Isaac against real designs, not pushed.
ZMX files/Papers/

# The same, downloaded rather than extracted from a paper: patent designs, other
# projects' repositories, and OpticStudio exports made from them. Third-party
# material under its own licences, and a `git add -A` away from being published
# by accident — which is what this rule is for.
ZMX files/From the web/

# OpticStudio prescription exports made from those files: its output, its
# formatting, and the designs' own numbers. Read by `npm run compare`, not
# committed. The reader has a fixture of its own under packages/zemax-io.
ZMX files/Prescriptions from Zemax/

# Deploy secrets: the shared relay token.
infra/.env.deploy

# Local environment: never committed. Vite reads apps/web/.env.local.
.env.local
.env.*.local
