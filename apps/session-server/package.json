{
  "name": "@isaac/session-server",
  "version": "0.1.0",
  "private": true,
  "description": "The relay that carries an Isaac session between browsers. It routes; it does not understand.",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "test": "node --experimental-strip-types --test 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@isaac/session-protocol": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ws": "^8.5.13"
  }
}
